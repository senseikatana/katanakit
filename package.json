{
  "name": "katanakit-css",
  "version": "0.12.0",
  "description": "KatanaKIT CSS — a lightweight, modular SCSS mini-framework: design tokens, utility classes and layout mixins (grid, flex, breakpoints) with a @apply-style system. Zero runtime overhead.",
  "keywords": [
    "scss",
    "sass",
    "css",
    "framework",
    "design-tokens",
    "utility-classes",
    "mixins",
    "grid",
    "flexbox",
    "breakpoints",
    "reset",
    "purgecss",
    "vite"
  ],
  "license": "MIT",
  "author": "senseikatana - Sergio Jurado",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/senseikatana/katanakit-css.git"
  },
  "homepage": "https://github.com/senseikatana/katanakit-css#readme",
  "bugs": {
    "url": "https://github.com/senseikatana/katanakit-css/issues"
  },
  "files": [
    "src/scss",
    "dist/css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sass": "src/scss/main.scss",
  "style": "dist/css/katanakit.css",
  "publishConfig": {
    "provenance": false
  },
  "scripts": {
    "dev": "cd docs && yarn start",
    "docs:build": "cd docs && yarn build",
    "docs:serve": "cd docs && yarn serve",
    "docs:clear": "cd docs && yarn clear",
    "docs:deploy": "cd docs && yarn deploy",
    "docs:swizzle": "cd docs && yarn swizzle",
    "docs:write-translations": "cd docs && yarn write-translations",
    "docs:write-heading-ids": "cd docs && yarn write-heading-ids",
    "build": "yarn run build:css && yarn run build:css:expanded",
    "build:css": "sass src/scss/main.scss dist/css/katanakit.css --no-source-map --style=compressed",
    "build:css:expanded": "sass src/scss/main.scss dist/css/katanakit.expanded.css --no-source-map --style=expanded",
    "build:css:purge": "sass src/scss/main.scss dist/css/katanakit.purged.css --no-source-map --style=compressed && postcss dist/css/katanakit.purged.css --replace --use autoprefixer --use @fullhuman/postcss-purgecss",
    "build:docs-css": "sudo ./scripts/build-docs-css.sh",
    "demo": "vite --config vite.config.mts",
    "demo:build": "vite build --config vite.config.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "sudo ./scripts/release.sh",
    "sync-versions": "sudo ./scripts/sync-versions.sh"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "astro": "^7.3.1",
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.26",
    "sass": "^1.103.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-purgecss": "^0.2.13",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@prosefly/astro-components": "^0.6.2",
    "@prosefly/astro-theme-lotus": "^0.7.3"
  }
}
