{
  "name": "katanakit-js",
  "version": "2.13.0",
  "description": "KatanaKit — a sharp, framework-agnostic TypeScript service toolkit organized with hexagonal architecture.",
  "type": "module",
  "workspaces": [
    "docs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters/express": {
      "types": "./dist/adapters/express/index.d.ts",
      "import": "./dist/adapters/express/index.js",
      "default": "./dist/adapters/express/index.js"
    },
    "./adapters/nuxt": {
      "types": "./dist/adapters/nuxt/index.d.ts",
      "import": "./dist/adapters/nuxt/index.js",
      "default": "./dist/adapters/nuxt/index.js"
    },
    "./adapters/vue": {
      "types": "./dist/adapters/vue/index.d.ts",
      "import": "./dist/adapters/vue/index.js",
      "default": "./dist/adapters/vue/index.js"
    },
    "./adapters/astro": {
      "types": "./dist/adapters/astro/index.d.ts",
      "import": "./dist/adapters/astro/index.js",
      "default": "./dist/adapters/astro/index.js"
    },
    "./prisma": {
      "types": "./dist/prisma/index.d.ts",
      "import": "./dist/prisma/index.js",
      "default": "./dist/prisma/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/adapters/express/main.ts",
    "check": "biome check ./src && tsc --noEmit && vitest run",
    "fix": "biome check --write ./src && tsc --noEmit && vitest run",
    "build": "yarn run check && tsc -p tsconfig.json",
    "release": "yarn build && npm version",
    "docs:dev": "yarn workspace katanakit-docs run dev",
    "docs:build": "yarn workspace katanakit-docs run build && mkdir -p dist/katanakit-js && cp -r docs/build/* dist/katanakit-js/",
    "docs:serve": "yarn workspace katanakit-docs run serve"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:senseikatana/katanakit-js.git"
  },
  "keywords": [
    "api",
    "fetch",
    "http-client",
    "url-builder",
    "typescript",
    "hexagonal-architecture",
    "astro",
    "express",
    "nuxt",
    "vue",
    "singleton",
    "observer",
    "factory"
  ],
  "author": "senseikatana - Sergio Jurado",
  "license": "MIT",
  "bugs": {
    "url": "https://senseikatana.github.io/katanakit-js/issues"
  },
  "unpkg": "./dist/index.js",
  "jsdelivr": "./dist/index.js",
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/orm-postgres": "^8.0.0-rc.8"
  },
  "peerDependencies": {
    "cors": ">=2.8.0",
    "dotenv": ">=16.0.0",
    "express": ">=5.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "cors": {
      "optional": true
    },
    "dotenv": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.4.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "prisma": "^8.0.0-rc.13",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue": "^3.5.42"
  },
  "packageManager": "yarn@4.18.0"
}
