{
  "name": "katanakit-css",
  "version": "0.12.5",
  "description": "KatanaKIT CSS — a lightweight, modular SCSS mini-framework: design tokens, utility classes and layout mixins (grid, flex, breakpoints) with a @apply-style system. Zero runtime overhead.",
  "keywords": [
    "scss",
    "sass",
    "css",
    "framework",
    "design-tokens",
    "utility-classes",
    "mixins",
    "grid",
    "flexbox",
    "breakpoints",
    "reset",
    "purgecss",
    "vite"
  ],
  "license": "MIT",
  "author": "senseikatana - Sergio Jurado",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/senseikatana/katanakit-css.git"
  },
  "homepage": "https://github.com/senseikatana/katanakit-css#readme",
  "bugs": {
    "url": "https://github.com/senseikatana/katanakit-css/issues"
  },
  "files": [
    "src/scss",
    "dist/css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sass": "src/scss/main.scss",
  "style": "dist/css/globals.min.css",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "scripts": {
    "dev": "concurrently -n demo,docs -c blue,green \"pnpm demo\" \"cd docs && pnpm start\"",
    "build": "concurrently \"pnpm build:css\" \"pnpm build:expanded\"",
    "build:css": "sass src/scss/main.scss dist/css/globals.min.css --no-source-map --style=compressed",
    "build:expanded": "sass src/scss/main.scss dist/css/globals.css --no-source-map --style=expanded",
    "build:purge": "sass src/scss/main.scss dist/css/globals.purged.css --no-source-map --style=compressed && postcss dist/css/globals.purged.css --replace --use autoprefixer --use @fullhuman/postcss-purgecss",
    "demo": "vite --config vite.config.mts",
    "demo:build": "vite build --config vite.config.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "./scripts/release.sh",
    "sync-versions": "./scripts/sync-versions.sh"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@types/node": "^22.20.1",
    "autoprefixer": "^10.5.5",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "sass": "^1.104.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-purgecss": "^0.2.13",
    "vitest": "^5.0.0"
  }
}
