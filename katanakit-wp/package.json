{
  "name": "katanakit-wp",
  "private": true,
  "description": "KatanaWP — code-first WordPress configuration. Bun scripts that wrap PHP via Docker (no local PHP required).",
  "scripts": {
    "composer": "docker run --rm -v \"$PWD\":/app -w /app composer:2",
    "test": "docker run --rm -v \"$PWD\":/app -w /app php:8.3-cli vendor/bin/phpunit",
    "lint": "docker run --rm -v \"$PWD\":/app -w /app php:8.3-cli vendor/bin/phpcs --standard=phpcs.xml",
    "lint:fix": "docker run --rm -v \"$PWD\":/app -w /app php:8.3-cli vendor/bin/phpcbf --standard=phpcs.xml",
    "wp:start": "bunx @wordpress/env start",
    "wp:stop": "bunx @wordpress/env stop"
  }
}
